# Public HTTP port of the application.
APP_PORT=8080

# Django container settings.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional cloud providers. Leave empty if they are not used.
OPENAI_API_KEY=
DEEP_SEEK_API_KEY=

# Local AI provider. Ollama itself runs in Docker Compose.
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=180

# Optional when the stack is placed behind another frontend/domain.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
